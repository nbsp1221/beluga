{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["packages/typescript-config/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["SystemRoot"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["PORT", "HOST_URL"],
      "passThroughEnv": ["CODEX_HOME", "SystemRoot"],
      "cache": false,
      "persistent": true
    },
    "//#lint:oxlint": {
      "dependsOn": ["@workspace/host-server#build"],
      "cache": false
    },
    "//#lint:oxlint:fix": {
      "dependsOn": ["@workspace/host-server#build"],
      "cache": false
    },
    "//#typecheck:root": {
      "dependsOn": ["@workspace/host-plugins#build", "@workspace/runtime#build"]
    },
    "//#test:integration": {
      "dependsOn": ["@workspace/host-plugins#build", "@workspace/runtime#build"],
      "passThroughEnv": ["SystemRoot"]
    }
  }
}
