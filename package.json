{
  "name": "dotdsh",
  "version": "0.0.0",
  "private": true,
  "description": "Reproducible host deployment for DeepSeek Harness",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --filter @dotdsh/dsh-auth build",
    "check:config": "dsh --profile web --patch ./config/host.patch.yml --dump-config",
    "lint": "pnpm --filter @dotdsh/dsh-auth lint",
    "start": "dsh --profile web --patch ./config/host.patch.yml",
    "test": "pnpm --filter @dotdsh/dsh-auth test",
    "typecheck": "pnpm --filter @dotdsh/dsh-auth typecheck"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  }
}
