{
  "name": "beluga",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint . && eslint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check-types": "turbo run check-types //#check-types:root",
    "check-types:root": "tsc --noEmit",
    "check": "turbo run lint format check-types //#check-types:root test",
    "test": "turbo run test",
    "test:install": "bash scripts/test-install.sh",
    "test:watch": "turbo run test:watch",
    "dev": "turbo run dev",
    "package": "turbo run package"
  },
  "devDependencies": {
    "@repo/format-config": "workspace:*",
    "@repo/lint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "10.13.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@12.16.1"
}
