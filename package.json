{
  "name": "beluga",
  "version": "0.1.0-preview.1",
  "private": true,
  "scripts": {
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "check": "pnpm format:check && pnpm check:boundaries && pnpm lint && pnpm typecheck:all && pnpm test:all && pnpm build:all",
    "lint": "turbo run lint:oxlint && turbo run lint:eslint lint:eslint:root",
    "lint:oxlint": "oxlint .",
    "lint:eslint:root": "eslint .",
    "lint:fix": "turbo run lint:oxlint:fix && turbo run lint:eslint:fix lint:eslint:fix:root",
    "lint:oxlint:fix": "oxlint --fix .",
    "lint:eslint:fix:root": "eslint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck:all": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test:all": "turbo run test test:integration",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "release:version": "changeset version && node scripts/version-release.mjs && pnpm release:check",
    "release:check": "node scripts/version-release.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "catalog:",
    "@workspace/client": "workspace:*",
    "@workspace/host-plugins": "workspace:*",
    "@workspace/tooling-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
