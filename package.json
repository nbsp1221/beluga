{
  "name": "beluga",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "turbo run lint:oxlint && eslint .",
    "lint:oxlint": "oxlint .",
    "lint:fix": "turbo run lint:oxlint:fix && eslint --fix .",
    "lint:oxlint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "turbo run test && turbo run test:integration",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "catalog:",
    "@workspace/client": "workspace:*",
    "@workspace/host-plugins": "workspace:*",
    "@workspace/tooling-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
