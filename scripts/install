#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: scripts/install\n'
}

if [[ "$#" -gt 0 ]]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
fi

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

escape_unit_value() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//%/%%}"
  value="${value//\$/\$\$}"
  printf '%s' "${value}"
}

readonly SCRIPT_PATH="$(realpath -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(dirname -- "${SCRIPT_PATH}")"
readonly REPO_ROOT="$(dirname -- "${SCRIPT_DIR}")"
readonly PNPM="$(command -v pnpm || true)"
readonly NODE_COMMAND="$(command -v node || true)"
[[ -n "${PNPM}" ]] || die 'pnpm is required on PATH.'
[[ -n "${NODE_COMMAND}" ]] || die 'Node.js is required on PATH.'
readonly NODE="$("${NODE_COMMAND}" -p 'process.execPath')"
readonly DSH_BIN="${REPO_ROOT}/node_modules/@deepseek-ai/dsh/lib/bin.js"
readonly AUTH_PACKAGE="${REPO_ROOT}/packages/plugins/dsh-auth"
readonly HOST_PATCH="${REPO_ROOT}/config/host.patch.yml"
readonly HOST_EXAMPLE="${REPO_ROOT}/config/host.patch.example.yml"
readonly UNIT_TEMPLATE="${REPO_ROOT}/deploy/systemd/dsh.service.in"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}"
readonly DSH_HOME_PATH="${DSH_HOME:-${HOME}/.dsh}"
[[ "${CONFIG_HOME}" == /* ]] || die 'XDG_CONFIG_HOME must be an absolute path.'
[[ "${DSH_HOME_PATH}" == /* ]] || die 'DSH_HOME must be an absolute path.'
readonly UNIT_TARGET="${CONFIG_HOME}/systemd/user/dsh.service"

[[ -x "${NODE}" ]] || die "Resolved Node.js executable is unavailable: ${NODE}"
[[ -f "${HOST_PATCH}" ]] || die "Create ${HOST_PATCH} from ${HOST_EXAMPLE}."
if [[ "$(<"${HOST_PATCH}")" == *"dsh.example.com"* ]]; then
  die "Replace the example publicOrigin in ${HOST_PATCH}."
fi

command -v systemctl >/dev/null || die 'systemctl is required.'
systemctl --user show-environment >/dev/null ||
  die 'The user systemd manager is unavailable.'

readonly USER_NAME="$(id -un)"
if command -v loginctl >/dev/null &&
  [[ "$(loginctl show-user "${USER_NAME}" -p Linger --value)" != "yes" ]]; then
  die "Enable boot-time startup first: sudo loginctl enable-linger ${USER_NAME}"
fi

"${PNPM}" install --frozen-lockfile
"${PNPM}" build
export DSH_HOME="${DSH_HOME_PATH}"
"${NODE}" "${DSH_BIN}" plugin --profile web add "link:${AUTH_PACKAGE}"
"${PNPM}" check:config

unit="$(<"${UNIT_TEMPLATE}")"
unit="${unit//@REPO_ROOT@/$(escape_unit_value "${REPO_ROOT}")}"
unit="${unit//@NODE_BIN@/$(escape_unit_value "${NODE}")}"
unit="${unit//@DSH_BIN@/$(escape_unit_value "${DSH_BIN}")}"
unit="${unit//@HOST_PATCH@/$(escape_unit_value "${HOST_PATCH}")}"
unit="${unit//@DSH_HOME@/$(escape_unit_value "${DSH_HOME_PATH}")}"

readonly TEMP_DIR="$(mktemp -d)"
trap 'rm -rf -- "${TEMP_DIR}"' EXIT
readonly RENDERED_UNIT="${TEMP_DIR}/dsh.service"
printf '%s\n' "${unit}" >"${RENDERED_UNIT}"
systemd-analyze --user verify "${RENDERED_UNIT}"

install -D -m 0644 "${RENDERED_UNIT}" "${UNIT_TARGET}"
systemctl --user daemon-reload
systemctl --user enable dsh.service
systemctl --user restart dsh.service

systemctl --user --no-pager --full status dsh.service
