[Unit]
Description=Beluga agent workspace

[Service]
Type=exec
WorkingDirectory=%h
ExecStart=%h/.local/lib/beluga/bin/beluga --no-open
# The launcher forwards SIGTERM to DSH; a second signal forces immediate exit.
KillMode=mixed
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
