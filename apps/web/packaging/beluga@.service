[Unit]
Description=Beluga agent workspace for %I
After=network.target

[Service]
Type=exec
User=%I
WorkingDirectory=~
ExecStart=/usr/local/lib/beluga/bin/beluga --no-open
# The launcher forwards SIGTERM to DSH; a second signal forces immediate exit.
KillMode=mixed
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
