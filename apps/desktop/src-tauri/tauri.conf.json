{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beluga",
  "version": "../package.json",
  "identifier": "io.github.nbsp1221.beluga",
  "build": {
    "beforeDevCommand": "pnpm dev:shell",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["dist/binaries/beluga-node"],
    "resources": {
      "dist/runtime/": ""
    },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
