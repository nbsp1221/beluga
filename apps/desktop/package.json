{
  "name": "@workspace/desktop",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:shell": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint:eslint": "eslint .",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:windows": "node scripts/prepare-windows.mjs",
    "package:windows": "pnpm prepare:windows && tauri build --bundles nsis && node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.2.1",
    "@workspace/tooling-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
