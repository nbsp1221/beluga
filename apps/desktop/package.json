{
  "name": "@workspace/desktop",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist/host"
  ],
  "type": "module",
  "scripts": {
    "dev:shell": "vite",
    "build": "pnpm typecheck && vite build && tsc -p host/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p host/tsconfig.json",
    "lint": "pnpm --filter \"{.}^...\" run --if-present build && oxlint --config ../../oxlint.config.mts . && eslint .",
    "lint:fix": "pnpm --filter \"{.}^...\" run --if-present build && oxlint --config ../../oxlint.config.mts --fix . && eslint --fix .",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:windows": "node scripts/prepare-windows.mjs",
    "package:windows": "tauri build --bundles nsis && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@workspace/host-plugins": "workspace:*",
    "@workspace/host-server": "workspace:*",
    "@workspace/protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.2.1",
    "@workspace/tooling-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
